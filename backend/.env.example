# --- Base de datos (Neon) -------------------------------------------------
# Pega aqui la cadena "Pooled connection" de Neon. Acepta el formato postgres://
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.eu-central-1.aws.neon.tech/nominas?sslmode=require

# --- Seguridad ------------------------------------------------------------
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_HORAS=12

# Cookie de sesion. Con front y back en dominios distintos hacen falta estos valores.
COOKIE_SEGURA=true
COOKIE_SAMESITE=none

# Clave de un solo uso para crear el primer administrador. VACIALA tras usarla.
CLAVE_ARRANQUE=

# --- CORS -----------------------------------------------------------------
# Origenes del frontend en Vercel, separados por comas y SIN barra final.
ORIGENES_PERMITIDOS=https://archivo-nominas.vercel.app

# --- Limites --------------------------------------------------------------
MAX_MB_SUBIDA=25
